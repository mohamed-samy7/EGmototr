@model EGYmotor.Models.Feedback

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us - EGYmotor</title>
    <link rel="stylesheet" href="~/css/feedback.css" />
</head>
<body>

    <div class="contact-section">
        <div class="contact-header">
            <h2>Contact Us</h2>
            <p>We’d love to hear from you! Reach out to us anytime.</p>
        </div>

        <div class="contact-grid">

            <div class="contact-info">
                <h3>📍 Our Location</h3>
                <p>EGYmotor Garage, 15 El-Tahrir St., Nasr City, Cairo, Egypt</p>

                <h3>📞 Call Us</h3>
                <p>+20 115 605 4974</p>

                <h3>📧 Email</h3>
                <p>Egymotor@gmail.com</p>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <h3>📝 Send Us a Message</h3>

                <div class="form-group">

                        <textarea asp-for="Message"
                                  rows="5"
                                  placeholder="Your Message"
                                  required>
                        </textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Feedback
                </button>
            </form>
            <a href="@Url.Action("AllFeedbacks", "Feedback")" class="view-feedback-btn">
                <button type="button">View Feedback</button>
            </a>

        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>
</html>
