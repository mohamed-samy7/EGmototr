@{
    Layout = "~/Views/_LayoutAdmin.cshtml";
}
@model List<EGYmotor.Models.Request>

@{
    ViewData["Title"] = "All Registered Users";
}
<link rel="stylesheet" href="~/css/ViewAllUsers.css" />
<h2>All Registered Users</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Problem</th>  <!-- جديد: عمود المشكلة -->
            <th>Location</th> <!-- جديد: عمود الموقع -->
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.RegisterUser?.UserName</td>
                <td>@user.RegisterUser?.Email</td>
                <td>@user.RegisterUser?.PhoneNumber</td>
                <td>@user.Problem</td>  <!-- عرض المشكلة، إذا كانت موجودة -->
                <td>@user.Location</td>
            </tr>
        }
    </tbody>
</table>
